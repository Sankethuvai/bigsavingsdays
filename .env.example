# --- Required in production -------------------------------------------------
# Public https origin. Used for generated short links, cookies, sitemap and metadata.
APP_URL=https://bigsavingsdays.com
# Alias kept for Next.js metadata; APP_URL wins when both are set.
NEXT_PUBLIC_APP_URL=https://bigsavingsdays.com

# Signs password-unlock cookies. Rotating it only invalidates unlocks.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Salt for one-way visitor IP hashes. Generate with: openssl rand -hex 24
IP_HASH_SALT=

# --- Storage ----------------------------------------------------------------
# SQLite database file. Put this on a persistent volume in production.
DATABASE_PATH=./data/velo.db

# --- Feature switches -------------------------------------------------------
# Demo workspace + /demo + homepage shortener. Defaults to on in development,
# off in production. Never enable in production on a public instance.
DEMO_MODE=

# Seed demo users, links and clicks on an empty database. Defaults to on in
# development, off in production. Must be 0 in production.
SEED_DEMO=

# Set to 0 only when Node is exposed directly and proxy headers are stripped.
TRUST_PROXY=1

# dns (production default) checks the _velo TXT record. manual is for local demos.
DOMAIN_VERIFY_MODE=

# CNAME target shown in the domain setup table (defaults to the APP_URL hostname).
# DOMAIN_CNAME_TARGET=velo.example.com

# Public support address shown on the contact page.
SUPPORT_EMAIL=support@example.com

# Set when running more than one Next.js instance (must be identical everywhere).
# Generate with: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
